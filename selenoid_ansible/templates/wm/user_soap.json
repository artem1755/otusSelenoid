{
  "request": {
    "method": "POST",
    "url": "/soap/user",
    "headers": {
      "Content-Type": {
        "matches": ".*text/xml.*"
      }
    },
    "bodyPatterns": [
      {
        "contains": "<soapenv:Body>"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/xml; charset=UTF-8"
    },
    "body": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"><soapenv:Body><ns2:getUserResponse xmlns:ns2=\"http://example.com/\"><return><id>123</id><name>John</name></return></ns2:getUserResponse></soapenv:Body></soapenv:Envelope>"
  }
}
